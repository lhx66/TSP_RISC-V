# Makefile for stack test
CROSS_COMPILE ?= riscv-none-elf-
CC = $(CROSS_COMPILE)gcc
OBJCOPY = $(CROSS_COMPILE)objcopy

ARCH_FLAGS = -march=rv32im -mabi=ilp32

CFLAGS = $(ARCH_FLAGS) -O0 -g -Wall \
         -ffunction-sections -fdata-sections \
         -fno-builtin -fno-common \
         -mstrict-align \
         -I.

LDFLAGS = $(ARCH_FLAGS) -T ../../linker.lds -nostartfiles \
          -Wl,--gc-sections

SRC = test_stack.c \
      ../../bsp/timer/bsp_timer.c \
      ../../bsp/uart/bsp_uart.c \
      ../../bsp/syscalls.c \
      ../../lib/startup/startup.S

all: test_stack.elf test_stack.bin

test_stack.elf: $(SRC)
	$(CC) $(LDFLAGS) -o $@ $(SRC)
	@echo "Test stack binary created!"

test_stack.bin: test_stack.elf
	$(OBJCOPY) -O binary $< $@
	@echo "Binary size:"
	@ls -lh test_stack.bin

clean:
	rm -f *.o *.elf *.bin
